// A collage plugin that serves a tiny client script: element getter shorthands,
// and a fragment fetched from its own URL put in place by replacing or morphing.
//
// It requires collage the way any consumer does, and reaches nothing the framework
// does not offer every plugin.
module github.com/Elagoht/collage-client

go 1.26

require github.com/Elagoht/collage v0.66.0
